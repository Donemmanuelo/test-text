# =============================================================================
# WhatsApp Clone — Backend Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker default. In production, use the Neon connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_clone

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker default. In production, use the Upstash Redis URL.
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
# NOTE: must be at least 32 characters long (the backend validates this).
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime in seconds (default: 15 minutes)
ACCESS_TOKEN_EXPIRY_SECONDS=900

# Refresh token lifetime in DAYS (default: 7)
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── S3 / Object Storage ───────────────────────────────────────────────────────
# For local development, use the MinIO defaults from docker-compose.yml.
# For production, use Supabase Storage or another S3-compatible service.
# The bucket must exist and be PUBLIC (the frontend loads media directly from it).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chat-media
S3_REGION=us-east-1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by the CORS middleware.
# In production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. For local dev, 8080 is the default.
PORT=8080

# ── Logging ───────────────────────────────────────────────────────────────────
# Tracing log level: trace | debug | info | warn | error
RUST_LOG=info

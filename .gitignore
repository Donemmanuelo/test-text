# =============================================================================
# Rust
# =============================================================================
# Compiled output — never commit
/backend/target/
target/

# Cargo.lock — keep for binary crates (this is a binary project)
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control
# Cargo.lock   <-- intentionally NOT ignored for this project

# SQLx offline query metadata — generated by `cargo sqlx prepare`
# Commit the .sqlx/ directory; ignore the legacy single-file variant
.sqlx/data.json
sqlx-data.json

# =============================================================================
# Node.js / Next.js
# =============================================================================
frontend/node_modules/
node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Vercel deployment artifacts
.vercel/
frontend/.vercel/

# Next.js cache
frontend/.cache/

# =============================================================================
# Environment / Secrets — NEVER commit real env files
# =============================================================================
.env
.env.local
.env.production
.env.production.local
.env.development.local
.env.test.local

# Keep the example/template files so developers know what to fill in
!.env.example
!backend/.env.example
!frontend/.env.local.example

# =============================================================================
# Operating System
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# IDEs & Editors
# =============================================================================
# VS Code — ignore personal settings but keep shared workspace config
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
# Keep: .vscode/extensions.json (recommended extensions)

# JetBrains (IntelliJ, CLion, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# =============================================================================
# Logs & Temp files
# =============================================================================
*.log
logs/
tmp/
temp/

# =============================================================================
# Docker
# =============================================================================
# Ignore local docker-compose overrides that might contain secrets
docker-compose.override.yml

# =============================================================================
# Misc
# =============================================================================
*.bak
*.orig
*.patch
*.rej

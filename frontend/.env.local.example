# =============================================================================
# WhatsApp Clone — Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# Base URL of the Rust backend REST API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL for WebSocket connections (use wss:// in production)
NEXT_PUBLIC_WS_URL=ws://localhost:8080
